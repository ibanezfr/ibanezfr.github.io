---
import { getCollection } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.url);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const lang = post.id.startsWith('es/') ? 'es' : 'en';

// Translated URL for language switching
const otherLang = lang === 'en' ? 'es' : 'en';
const baseSlug  = post.slug.replace(/^(en|es)\//, '');
const allHosted = await getCollection('blog', ({ data }) => !data.url);
const otherPost = allHosted.find(p => {
  if (!p.id.startsWith(otherLang + '/')) return false;
  if (post.data.translationKey && p.data.translationKey)
    return p.data.translationKey === post.data.translationKey;
  return p.slug.replace(/^(en|es)\//, '') === baseSlug;
});
const translatedUrl = otherPost ? `/${otherPost.slug}/` : '/#blog';
const canonicalUrl  = `https://ibanezfr.github.io/${post.slug}/`;

// Read time
const wordCount   = post.body.split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

// Formatted date: DD mmm YYYY
const MONTHS = {
  en: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
  es: ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'],
};
const d = post.data.date;
const formattedDate = `${d.getDate()} ${MONTHS[lang as 'en' | 'es'][d.getMonth()]} ${d.getFullYear()}`;

// TOC from H2 headings
const sections = headings
  .filter(h => h.depth === 2)
  .map(h => ({ id: h.slug, label: h.text }));

// Next post by date ascending in same lang (skip if only one post)
const sameLang = allHosted
  .filter(p => p.id.startsWith(lang + '/'))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const idx    = sameLang.findIndex(p => p.slug === post.slug);
const nextRaw = sameLang[idx + 1] ?? sameLang[0];
const nextPost = nextRaw && nextRaw.slug !== post.slug ? {
  slug:        nextRaw.slug,
  title:       nextRaw.data.title,
  desc:        nextRaw.data.desc,
  tag:         nextRaw.data.tags,
  readMinutes: Math.max(1, Math.round(nextRaw.body.split(/\s+/).filter(Boolean).length / 200)),
} : undefined;

// Share URLs
const encodedUrl   = encodeURIComponent(canonicalUrl);
const encodedTitle = encodeURIComponent(post.data.title);
const whatsappUrl  = `https://wa.me/?text=${encodeURIComponent(post.data.title + ' — ' + canonicalUrl)}`;
const linkedinUrl  = `https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}&summary=${encodeURIComponent(post.data.desc)}`;
const twitterUrl   = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const telegramUrl  = `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`;
---

<ArticleLayout
  lang={lang}
  title={post.data.title}
  description={post.data.desc}
  canonicalUrl={canonicalUrl}
  tag={post.data.tags}
  formattedDate={formattedDate}
  readMinutes={readMinutes}
  sections={sections}
  translatedUrl={translatedUrl}
  whatsappUrl={whatsappUrl}
  linkedinUrl={linkedinUrl}
  twitterUrl={twitterUrl}
  telegramUrl={telegramUrl}
  nextPost={nextPost}
>
  <Content />
</ArticleLayout>
