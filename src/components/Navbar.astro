---
const isHome = Astro.url.pathname === '/';
const homeHref = isHome ? '#home' : '/#home';
const blogHref = isHome ? '#blog' : '/#blog';
---
<header class="topbar">
  <div class="topbar-brand">
    <span class="topbar-brand-dot"></span>
    <a href={homeHref} class="topbar-name">franco.ibañez</a>
  </div>

  <nav class="topbar-nav">
    <a href={homeHref} class="topbar-link" data-en="Home" data-es="Inicio">Home</a>
    <a href={blogHref} class="topbar-link" data-en="Blog" data-es="Blog">Blog</a>
  </nav>

  <div class="topbar-actions">
    <button id="lang-toggle" class="icon-btn lang-btn" aria-label="Toggle language" title="Idioma / Language">ES</button>
    <button id="theme-toggle" class="icon-btn" aria-label="Toggle theme" title="Toggle light/dark">
      <span id="icon-sun" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </span>
      <span id="icon-moon" aria-hidden="true" style="display:none">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </span>
    </button>
  </div>
</header>
