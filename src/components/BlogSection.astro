---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

const enPosts = posts
  .filter(p => p.id.startsWith('en/'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const esPosts = posts
  .filter(p => p.id.startsWith('es/'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const enTags = [...new Set(enPosts.map(p => p.data.tags))];
const esTags = [...new Set(esPosts.map(p => p.data.tags))];
---

<section id="blog">

  <!-- ── English ──────────────────────────────── -->
  <div data-lang-section="en">
    <div class="accA-wrap">
      <div class="accA-header">
        <div class="accA-eyebrow">BLOG · 01</div>
        <h2 class="accA-title">Articles <span class="accA-muted">/ by topic</span></h2>
      </div>

      <div class="accA-shell">
        <div class="accA-shell-chrome">
          <span class="pt-dot" style="background:#ff5f57"></span>
          <span class="pt-dot" style="background:#febc2e"></span>
          <span class="pt-dot" style="background:#28c840"></span>
          <span class="accA-path">~/blog</span>
        </div>

        <div class="accA-body" data-acc="en">
          {enTags.map((tag, i) => {
            const tagPosts = enPosts.filter(p => p.data.tags === tag);
            return (
              <div class={`accA-item${i === 0 ? ' is-open' : ''}`} data-acc-item>
                <button
                  class="accA-button"
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`en-panel-${i}`}
                  data-acc-btn
                >
                  <span class="accA-prompt">$</span>
                  <span class="accA-cmd">cd</span>
                  <span class="accA-arg">./{tag}</span>
                  <span class="accA-count">({tagPosts.length})</span>
                  <span class="accA-chev" aria-hidden="true">{i === 0 ? '▾' : '▸'}</span>
                </button>
                <div class="accA-panel" id={`en-panel-${i}`} data-acc-panel>
                  <div class="accA-ls">
                    <span class="accA-prompt">$</span>
                    <span class="accA-cmd">ls</span>
                    <span class="accA-flag">-la</span>
                  </div>
                  <ul class="accA-list">
                    {tagPosts.map(post => (
                      <li class="accA-row">
                        <span class="accA-date">{post.data.date.toISOString().slice(0, 10)}</span>
                        <a
                          class="accA-link"
                          href={post.data.url ?? `/${post.slug}`}
                          target={post.data.url ? '_blank' : undefined}
                          rel={post.data.url ? 'noopener noreferrer' : undefined}
                        >
                          <span class="accA-file">{post.data.title}</span>
                          <span class="accA-desc">{post.data.desc}</span>
                        </a>
                        <span class="accA-read">—</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <!-- ── Español ──────────────────────────────── -->
  <div data-lang-section="es" hidden>
    <div class="accA-wrap">
      <div class="accA-header">
        <div class="accA-eyebrow">BLOG · 01</div>
        <h2 class="accA-title">Artículos <span class="accA-muted">/ por tema</span></h2>
      </div>

      <div class="accA-shell">
        <div class="accA-shell-chrome">
          <span class="pt-dot" style="background:#ff5f57"></span>
          <span class="pt-dot" style="background:#febc2e"></span>
          <span class="pt-dot" style="background:#28c840"></span>
          <span class="accA-path">~/blog</span>
        </div>

        <div class="accA-body" data-acc="es">
          {esTags.map((tag, i) => {
            const tagPosts = esPosts.filter(p => p.data.tags === tag);
            return (
              <div class={`accA-item${i === 0 ? ' is-open' : ''}`} data-acc-item>
                <button
                  class="accA-button"
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`es-panel-${i}`}
                  data-acc-btn
                >
                  <span class="accA-prompt">$</span>
                  <span class="accA-cmd">cd</span>
                  <span class="accA-arg">./{tag}</span>
                  <span class="accA-count">({tagPosts.length})</span>
                  <span class="accA-chev" aria-hidden="true">{i === 0 ? '▾' : '▸'}</span>
                </button>
                <div class="accA-panel" id={`es-panel-${i}`} data-acc-panel>
                  <div class="accA-ls">
                    <span class="accA-prompt">$</span>
                    <span class="accA-cmd">ls</span>
                    <span class="accA-flag">-la</span>
                  </div>
                  <ul class="accA-list">
                    {tagPosts.map(post => (
                      <li class="accA-row">
                        <span class="accA-date">{post.data.date.toISOString().slice(0, 10)}</span>
                        <a
                          class="accA-link"
                          href={post.data.url ?? `/${post.slug}`}
                          target={post.data.url ? '_blank' : undefined}
                          rel={post.data.url ? 'noopener noreferrer' : undefined}
                        >
                          <span class="accA-file">{post.data.title}</span>
                          <span class="accA-desc">{post.data.desc}</span>
                        </a>
                        <span class="accA-read">—</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>

</section>

<script>
  document.querySelectorAll('[data-acc-btn]').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-acc-item]');
      const body = btn.closest('[data-acc]');
      const isOpen = item.classList.contains('is-open');

      // Close all in this accordion body
      body.querySelectorAll('[data-acc-item]').forEach(el => {
        el.classList.remove('is-open');
        el.querySelector('[data-acc-btn]').setAttribute('aria-expanded', 'false');
        el.querySelector('[data-acc-btn] .accA-chev').textContent = '▸';
      });

      // Open clicked if it was closed
      if (!isOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        btn.querySelector('.accA-chev').textContent = '▾';
      }
    });
  });
</script>
