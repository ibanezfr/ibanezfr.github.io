---
---
<section id="home">
  <div class="hero-shell">
    <div class="hero-grid">

      <!-- ── Left: copy ────────────────────────── -->
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="hero-dot"></span>
          <span data-en="Open to projects · Buenos Aires" data-es="Disponible para proyectos · Buenos Aires">Disponible para proyectos · Buenos Aires</span>
        </div>

        <h1 class="hero-name">
          Franco Ezequiel<br/>Ibañez<span class="hero-cursor">_</span>
        </h1>

        <div class="hero-role">
          <span class="hero-role-primary">[Python Developer]</span>
          <span class="hero-role-sep">·</span>
          <span class="hero-role-secondary">[AI Researcher]</span>
        </div>

        <p class="hero-bio"
           data-en="I build generative AI applications, LLM pipelines and automations. I document what I learn on the blog."
           data-es="Construyo aplicaciones de IA generativa, pipelines con LLMs y automatizaciones. Documento lo que aprendo en el blog.">
          Construyo aplicaciones de IA generativa, pipelines con LLMs y automatizaciones. Documento lo que aprendo en el blog.
        </p>

        <div class="hero-tags">
          <span class="hero-tag">Python</span>
          <span class="hero-tag">Generative AI</span>
          <span class="hero-tag">LLM Apps</span>
          <span class="hero-tag">Automation</span>
          <span class="hero-tag">FastAPI</span>
        </div>

        <div class="hero-cta">
          <a href="#blog" class="btn-primary" data-en="read the blog" data-es="leer el blog">
            leer el blog
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="#" class="btn-ghost" id="cv" data-en="see resume" data-es="consultar cv">consultar cv</a>
        </div>

        <div class="hero-social-links">
          <a class="hero-social-link" href="https://www.linkedin.com/in/ibanezfr" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
            <span>LinkedIn</span>
          </a>
          <a class="hero-social-link" href="https://github.com/ibanezfr" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.3-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.3a11.5 11.5 0 0 1 6 0c2.3-1.6 3.3-1.3 3.3-1.3.6 1.7.2 2.9.1 3.2.8.9 1.2 2 1.2 3.3 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.3v3.4c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg>
            <span>GitHub</span>
          </a>
        </div>

        <div class="hero-meta">
          <div class="hero-meta-item">
            <div class="hero-meta-k">7</div>
            <div class="hero-meta-l" data-en="articles" data-es="artículos">artículos</div>
          </div>
          <div class="hero-meta-div"></div>
          <div class="hero-meta-item">
            <div class="hero-meta-k">3</div>
            <div class="hero-meta-l" data-en="categories" data-es="categorías">categorías</div>
          </div>
          <div class="hero-meta-div"></div>
          <div class="hero-meta-item">
            <div class="hero-meta-k">2026</div>
            <div class="hero-meta-l" data-en="active" data-es="activo">activo</div>
          </div>
        </div>
      </div>

      <!-- ── Right: portrait terminal ──────────── -->
      <div class="hero-portrait">
        <div class="portrait-terminal">
          <div class="pt-chrome">
            <span class="pt-dot" style="background:#ff5f57"></span>
            <span class="pt-dot" style="background:#febc2e"></span>
            <span class="pt-dot" style="background:#28c840"></span>
            <span class="pt-title">~/franco — zsh</span>
          </div>
          <div class="pt-body">
            <div class="pt-line"><span class="pt-prompt">$</span> whoami</div>
            <div class="pt-line pt-out">franco.ibañez</div>
            <div class="pt-img-wrap">
              <img src="/images/profile-pic-03.webp" alt="Franco Ibañez" width="380" height="380" />
              <div class="pt-img-scan"></div>
            </div>
            <div class="pt-line"><span class="pt-prompt">$</span> cat role.txt</div>
            <div class="pt-line pt-out">python · llms · automation</div>
            <div class="pt-line"><span class="pt-prompt">$</span> <span class="pt-caret">|</span></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
